{
  "name": "nai-image-studio",
  "private": true,
  "version": "0.2.12",
  "type": "module",
  "description": "NovelAI 图像生成工作台（桌面端）",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gothamkismet-cyber/nai-image-studio.git"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "author": {
    "name": "gothamkismet-cyber"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "npm run build && node scripts/verify.mjs",
    "desktop": "npm run build && electron .",
    "desktop:dev": "node scripts/desktop-dev.mjs",
    "dist": "npm run build && electron-builder --win"
  },
  "build": {
    "afterAllArtifactBuild": "build/after-artifacts.cjs",
    "appId": "studio.nai.image",
    "productName": "NAI生图台",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "LICENSE"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "guid": "ffcd3877-c614-52f9-84f7-1d5625f865ef",
      "license": "build/license.txt",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NAI生图台",
      "uninstallDisplayName": "NAI生图台 0.2.12",
      "deleteAppDataOnUninstall": false,
      "artifactName": "NAI-Image-Studio-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "NAI-Image-Studio-Portable-${version}.${ext}"
    }
  },
  "dependencies": {
    "jszip": "^3.10.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
